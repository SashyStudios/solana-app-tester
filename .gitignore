# Log files
*.log

# OS-generated files
.DS_Store
Thumbs.db

# Google Services (if added later — keep out unless intentionally committed)
google-services.json

# Devnet/test wallet keypairs — never commit private keys
*.json.key
test-wallet-*.json
setup/skr-mint-authority.json
