<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Needed by the Solana RPC client in the signing stage. The MWA wallet handshake itself
        is a local socket association and doesn't need it, but it's declared here with the
        dependencies rather than left to be discovered as a confusing failure later.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Android 11+ package visibility: without this, PackageManager.getLaunchIntentForPackage
        returns null for another app even when it's installed, which replay() can't tell apart
        from "not installed" - see the Oct 4 investigation. The MAIN/LAUNCHER intent query
        (added Oct 6, for per-app saved flows) makes every ordinary launchable app visible,
        covering any app a flow gets saved for without listing packages one at a time - the
        two explicit <package> entries below are now redundant for apps with a launcher icon
        but are left in place as harmless, explicit documentation of what this tool targets.
        Wallet packages (Phantom, Solflare, etc.) are deliberately not listed yet - add them
        when replay needs to launch a wallet directly (most wallet flows are reached via MWA's
        own intent routing, not a direct launch, so they may not need an entry here at all).
    -->
    <queries>
        <package android:name="com.clockin.mwatestapp" />
        <package android:name="com.sashystudios.seekshot" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppTester">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AppTester">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".RecordingAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
